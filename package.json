{
  "name": "buscar-novel-individual",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema simples para salvar links de novels e ler capítulos extraídos via Playwright, com tradução nativa do navegador.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron:dev": "electron electron/main.js",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "@lesjoursfr/html-to-epub": "^6.2.0",
    "express": "^4.21.2",
    "pdfkit": "^0.20.2",
    "playwright-core": "^1.49.1"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.buscarnovel.app",
    "productName": "Minhas Novels",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    }
  }
}
